{
  "imports": {
    "zod": "npm:zod@4.6.7",
    "@supabase/supabase-js": "npm:@supabase/supabase-js@2.118.0",
    "@anthropic-ai/sdk": "npm:@anthropic-ai/sdk@1.3.0",
    "@anthropic-ai/sdk/": "npm:/@anthropic-ai/sdk@1.3.0/",
    "@std/assert": "jsr:@std/assert@1.0.13"
  },
  "compilerOptions": {
    "strict": true,
    "noImplicitAny": true,
    "noUncheckedIndexedAccess": true
  },
  "tasks": {
    "check": "deno check **/*.ts",
    "test": "deno test --allow-env --allow-read",
    "schemas": "deno run --allow-read --allow-write=../../schemas scripts/generate-json-schemas.ts",
    "ci": "deno fmt --check && deno lint && deno check **/*.ts && deno test --allow-env --allow-read"
  },
  "lint": {
    "rules": {
      "include": [
        "no-explicit-any"
      ]
    }
  },
  "fmt": {
    "lineWidth": 120
  }
}
