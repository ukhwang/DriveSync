# Copy to supabase/functions/.env for `supabase functions serve --env-file`, or set on a hosted
# project with `supabase secrets set --env-file`. NEVER commit the real file.
ANTHROPIC_API_KEY=
# Optional override; default claude-opus-5-5
LLM_MODEL=
RESEND_API_KEY=
MAIL_FROM=DriveSync <onboarding@resend.dev>
# Comma-separated allowlist for live demos (empty = any recipient)
ALLOWED_RECIPIENT_DOMAINS=
