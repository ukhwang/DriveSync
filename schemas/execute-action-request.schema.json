{
  "$id": "https://drivesync.app/schemas/execute-action-request.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "actionId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100
    },
    "idempotencyKey": {
      "type": "string",
      "pattern": "^[^:\\s]+:v\\d+$"
    },
    "draft": {
      "type": "object",
      "properties": {
        "to": {
          "type": "string",
          "format": "email",
          "pattern": "^(?:[A-Za-z0-9_'+\\-]+\\.)*[A-Za-z0-9_'+\\-]*[A-Za-z0-9_+-]@(?:[A-Za-z0-9][A-Za-z0-9\\-]*\\.)+[A-Za-z]{2,}$"
        },
        "subject": {
          "type": "string",
          "minLength": 1,
          "maxLength": 150
        },
        "body": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4000
        }
      },
      "required": [
        "to",
        "subject",
        "body"
      ],
      "additionalProperties": false
    },
    "draftVersion": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    }
  },
  "required": [
    "actionId",
    "idempotencyKey",
    "draft",
    "draftVersion"
  ],
  "additionalProperties": false
}
